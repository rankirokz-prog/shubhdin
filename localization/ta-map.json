 "remedy": {
  "sun": "ஞாயிற்றுக்கிழமை உதயசூரியனுக்கு அர்க்கியம் தரவும், தந்தை மற்றும் பெரியோரை மதிக்கவும், கோதுமை அல்லது வெல்லம் தானம் செய்யவும். தன்னம்பிக்கையும் மதிப்பும் வளரும்.",
  "moon": "திங்கட்கிழமையை அமைதியாக, தூய்மையாகக் கழிக்கவும், தாயை மதிக்கவும், அரிசி அல்லது பால் தானம் செய்யவும். மனம் அமைதி பெறும்.",
  "mars": "செவ்வாய்க்கிழமை அனுமன் சாலீசா ஓதவும், உடல் ஒழுக்கம் காக்கவும், துவரம்பருப்பு அல்லது சிவப்பு துணி தானம் செய்யவும். தைரியமும் ஆற்றலும் வளரும்.",
  "mercury": "புதன்கிழமை பசுக்களுக்கு பசும்புல் தரவும், பேச்சை உண்மையாகவும் இனிமையாகவும் வைக்கவும், பாசிப்பருப்பு தானம் செய்யவும். புத்திசாலித்தனமும் தொடர்புகளும் வளரும்.",
  "jupiter": "வியாழக்கிழமை குருமார்களை சேவிக்கவும், ஞானத்தைப் பகிரவும், மஞ்சள், கடலைப்பருப்பு அல்லது புத்தகம் தானம் செய்யவும். ஞானமும் அதிர்ஷ்டமும் வளரும்.",
  "venus": "வெள்ளிக்கிழமை லக்ஷ்மியை வழிபடவும், வெள்ளை அல்லது இளஞ்சிவப்பு மலர்களை அர்ப்பணிக்கவும், அழகை ஆதரிக்கவும், உதாரமாக கொடுக்கவும். காதலிலும் உறவுகளிலும் இனிமை பெருகும்.",
  "saturn": "சனிக்கிழமை முதியோர், தொழிலாளர், மாற்றுத்திறனாளிகளுக்கு சேவை செய்யவும், எள்ளெண்ணெய் விளக்கேற்றவும், கருப்பு எள் அல்லது இரும்பு தானம் செய்யவும். பொறுமையும் நிலைத்த வெற்றியும் கிடைக்கும்.",
  "rahu": "ஆசைகளில் நேர்மையான தெளிவு வைக்கவும், பறவைகளுக்கு உணவளிக்கவும், சனிக்கிழமை ஏழைகளுக்கு போர்வை தானம் செய்யவும். திடீர் தடைகள் விலகும்.",
  "ketu": "தினமும் தியானம் அல்லது ஜபம் செய்யவும், தெரு நாய்களைப் பராமரிக்கவும், பல வண்ணப் போர்வை அல்லது எள் தானம் செய்யவும். ஆன்மிகத் தெளிவு பெருகும்."
 },
